{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@perfgym/core": ["packages/core/src/index.ts"],
      "@perfgym/core/bench": ["packages/core/src/bench/blackhole.ts"],
      "@perfgym/cli": ["packages/cli/src/index.ts"],
      "@perfgym/linter": ["packages/linter/src/index.ts"],
      "@perfgym/adapter-web": ["packages/adapters/web/src/index.ts"],
      "@perfgym/mcp-server": ["packages/mcp-server/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
